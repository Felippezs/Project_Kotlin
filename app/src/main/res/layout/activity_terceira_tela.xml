<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_estrela"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/white"
        android:text="@string/integrantes_do_grupo"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView3"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/felippe_pereira"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="italic"/>

    <TextView
        android:id="@+id/textView4"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/murillo_perajon"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="italic"/>

    <TextView
        android:id="@+id/textView5"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gustavo_rodrigues"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="italic"/>

    <TextView
        android:id="@+id/textView6"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pedro_rogel"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="italic"/>

    <TextView
        android:id="@+id/textView7"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fernando_barreto"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="italic"/>


    <Button
        android:id="@+id/button3"
        android:layout_width="match_parent"

        android:layout_height="78dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#9FA0A2"
        android:text="@string/voltarrr"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/editTextText"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:ems="10"
        android:background="@color/white"
        android:hint="@string/digite_a_nota"
        android:autofillHints=""
        android:inputType="number|numberDecimal"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/Editavaliar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#9FA0A2"
        android:text="@string/avaliar"
        android:textSize="16sp"
        app:iconTint="#838080" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/resultadoo"
        android:background="@color/white"
        android:textSize="24sp" />
</LinearLayout>
